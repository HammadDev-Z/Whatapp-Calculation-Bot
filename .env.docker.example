# Group id (ends in @g.us) allowed to run /calculate. Leave empty for none.
CALCULATION_REPORT_GROUP_ID=
LOG_LEVEL=info

# Website. SITE_DOMAIN must have an A record pointing at this server.
SITE_DOMAIN=codeguy.pp.ua
# Used once, to create the first admin login. Pick your own password (8+ characters), then change
# it on the website's Account page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
