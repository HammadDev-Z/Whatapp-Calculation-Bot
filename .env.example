NODE_ENV=production

DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_calculator

# Group id (ends in @g.us) allowed to run /calculate. Leave empty for none.
CALCULATION_REPORT_GROUP_ID=

WHATSAPP_SESSION_PATH=.whatsapp-session
CHROME_EXECUTABLE_PATH=

LOG_LEVEL=info

# Website (npm run web). ADMIN_* only creates the first admin login.
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
